# Copie para .env e ajuste. NUNCA versione o .env (contém senhas).

# Domínio público (HTTPS automático). Use "localhost" para rede local com certificado interno.
DOMINIO=localhost
APP_URL=https://localhost

# Banco
POSTGRES_USER=leads
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=leads

# Segurança
SECRET_KEY=gere-com-openssl-rand-hex-32
SESSAO_HORAS=12
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MIN=15
PUBLIC_RATE_LIMIT_MIN=30
APP_TIMEZONE=America/Sao_Paulo

# Primeiro administrador (criado só se não houver nenhum). Troque a senha no primeiro acesso.
SEED_ADMIN_EMAIL=admin@tenti.com.br
SEED_ADMIN_SENHA=Admin@12345

# E-mail corporativo comercial@tenti.com.br (SMTP para envio)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USUARIO=comercial@tenti.com.br
SMTP_SENHA=
EMAIL_REMETENTE=comercial@tenti.com.br
EMAIL_REMETENTE_NOME=Comercial Tenti
# Em desenvolvimento, com --profile dev: SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_TLS=nenhum

# Leitura da caixa (Fase 3). Vazio = desativado.
IMAP_HOST=
IMAP_PORT=993
IMAP_USUARIO=comercial@tenti.com.br
IMAP_SENHA=
IMAP_PASTA=INBOX
IMAP_INTERVALO_SEG=120

# Backups
BACKUP_DIR=./backups
BACKUP_HORA=02
BACKUP_RETENCAO_DIAS=30
